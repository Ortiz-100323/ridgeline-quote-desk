ANTHROPIC_API_KEY=
MODEL_NAME=
FALLBACK_MODEL=
# Worker LLM extraction (app/worker/settings.py). Empty = the default shown in the comment.
# Per HTTP request, in seconds (120)
LLM_TIMEOUT_SECONDS=
# Retries after the first try on timeouts / 408 / 409 / 429 / 5xx, per model (3)
LLM_MAX_RETRIES=
# Backoff: base * 2^(retry-1), capped, plus jitter (2 / 30 seconds)
LLM_RETRY_BACKOFF_SECONDS=
LLM_RETRY_MAX_BACKOFF_SECONDS=
# Below this document confidence, the request is re-sent to FALLBACK_MODEL (0.8)
LLM_CONFIDENCE_THRESHOLD=
# Output token cap per call (16000)
LLM_MAX_TOKENS=
# low|medium|high|xhigh|max, or empty for the model's default
LLM_EFFORT=
# Worker loop (app/worker/worker.py)
# Worker processes started by python -m app.worker; --workers overrides it (1)
WORKER_COUNT=
# Wait when the queue is empty, seconds (5)
WORKER_POLL_SECONDS=
# Job lease; a heartbeat renews it every lease/3. Expired leases are reclaimed (600)
WORKER_LEASE_SECONDS=
# Job retry delay = base * 2^(attempts-1), seconds (60)
WORKER_RETRY_BACKOFF_SECONDS=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
MATCH_REVIEW_THRESHOLD=
